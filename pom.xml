<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Root aggregator: builds the sample (Maven) and the IntelliJ plugin (Gradle) in one go.
        The plugin is not a Maven module, so its Gradle wrapper is invoked via exec-maven-plugin:
          mvn clean   -> gradlew clean
          mvn package -> gradlew buildPlugin  (zip in MaskeRade-intellij-plugin/build/distributions)
        Skip the plugin with -DskipPlugin.
    -->
    <groupId>com.pixeldweller</groupId>
    <artifactId>maskerade-root</artifactId>
    <version>0.1-alpha</version>
    <packaging>pom</packaging>

    <modules>
        <module>MaskeRade-sample</module>
    </modules>

    <properties>
        <plugin.dir>${project.basedir}/MaskeRade-intellij-plugin</plugin.dir>
        <gradlew>${plugin.dir}/gradlew</gradlew>
        <skipPlugin>false</skipPlugin>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <inherited>false</inherited>
                <configuration>
                    <executable>${gradlew}</executable>
                    <workingDirectory>${plugin.dir}</workingDirectory>
                    <skip>${skipPlugin}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>gradle-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>clean</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>gradle-build-plugin</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>buildPlugin</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <gradlew>${plugin.dir}/gradlew.bat</gradlew>
            </properties>
        </profile>
    </profiles>
</project>
